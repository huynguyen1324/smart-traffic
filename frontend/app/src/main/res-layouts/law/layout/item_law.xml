<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Số thứ tự -->
        <TextView
            android:id="@+id/tvLawNumber"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_assistant_circle"
            android:backgroundTint="#EDE9FE"
            android:gravity="center"
            android:text="1"
            android:textColor="#7C3AED"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Ảnh thumbnail -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThumb"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="#E2E8F0">
            <ImageView
                android:id="@+id/ivLawThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_login_banner" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLawTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Tên điều luật"
                android:textColor="#0F172A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvLawDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lines="2"
                android:text="Mô tả sơ lược..."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#CBD5E1"
            android:textSize="24sp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>


