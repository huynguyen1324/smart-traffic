<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomNav">

        <!-- Background map -->
        <ImageView
            android:id="@+id/imgMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:color/darker_gray"
            android:contentDescription="Bản đồ thực hành" />

        <!-- Top content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#0F172A"
                    android:background="@drawable/bg_map_circle_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Bản đồ thực hành"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />
            </RelativeLayout>

            <!-- Search -->
            <EditText
                android:id="@+id/edtMapSearch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_input"
                android:hint="Trung tâm đào tạo lái xe C500"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="#0F172A"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Zoom button fake -->
        <TextView
            android:id="@+id/btnZoom"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:text="+"
            android:textSize="28sp"
            android:textColor="#0F172A"
            android:background="@drawable/bg_map_circle_button" />

        <!-- Bottom sheet fake -->
        <LinearLayout
            android:id="@+id/layoutBottomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_map_bottom_sheet"
            android:padding="20dp">

            <View
                android:layout_width="60dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:background="#CBD5E1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trung tâm đào tạo lái xe C500"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.8 ★★★★☆ (1,240 đánh giá)"
                        android:textSize="16sp"
                        android:textColor="#22C1E8"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:text="1.2\nkm"
                    android:textColor="#22C1E8"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_distance_circle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDirection"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Đường đi"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="#22C1E8"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Gọi điện"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp"
                    app:cornerRadius="28dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#E2E8F0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số 500, đường Trần Phú, Hà Đông, Hà Nội"
                android:textColor="#475569"
                android:textSize="16sp"
                android:layout_marginTop="18dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </FrameLayout>

    <include android:id="@+id/layoutBottomNav" layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>


