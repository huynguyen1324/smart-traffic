<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="1dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#0F172A"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-black"
            android:text="Trợ lý Giao thông"
            android:textColor="#0F172A"
            android:textSize="20sp" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/inputLayout"
        android:layout_below="@id/header"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Floating Input Bar -->
    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/layoutBottomNav"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:elevation="4dp">

        <!-- Image Preview (Hidden by default) -->
        <RelativeLayout
            android:id="@+id/previewContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">
                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>
            <ImageView
                android:id="@+id/btnRemoveImage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignTop="@+id/previewContainer"
                android:layout_alignEnd="@+id/previewContainer"
                android:layout_marginEnd="-8dp"
                android:layout_marginTop="-8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#EF4444"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnAttach"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#64748B"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <EditText
                    android:id="@+id/edtMessage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Nhập thắc mắc..."
                    android:paddingHorizontal="20dp"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:padding="0dp"
                android:text="➤"
                android:textSize="18sp"
                app:backgroundTint="#22C1E8"
                app:cornerRadius="25dp"
                app:elevation="2dp" />
        </LinearLayout>
    </LinearLayout>

    <include android:id="@+id/layoutBottomNav" layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>


