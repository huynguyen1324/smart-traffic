<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartTraffic" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <!-- Khớp màu nền với các layout để tránh chớp trắng khi chuyển màn hình -->
        <item name="android:windowBackground">@drawable/bg_main_gradient</item>
    </style>

    <style name="Theme.SmartTraffic" parent="Base.Theme.SmartTraffic">
    </style>

    <!-- Phong cách thẻ dùng chung (Modern Material Card) -->
    <style name="Widget.SmartTraffic.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#E2E8F0</item>
    </style>
</resources>